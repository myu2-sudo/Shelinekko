$FirebaseSDKVersion = '10.24.0'
# Uncomment this line to define a global platform for your project
platform :ios, '15.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

pod 'SDWebImage', '~> 5.19.0'

target 'Runner' do
  use_frameworks!
  use_modular_headers!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))

  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  # Helper: フラグ群から -G を徹底的に排除する関数
  def remove_g_flag(hash)
    hash.keys.each do |key|
      next unless key.to_s.include?('FLAGS') || key.to_s.include?('DEFINITIONS') || key.to_s.include?('CFLAGS')

      val = hash[key]
      if val.is_a?(Array)
        val.reject! { |f| f.to_s == '-G' || f.to_s.match?(/-G(\s+|$)/) }
      elsif val.is_a?(String)
        hash[key] = val.gsub(/-G(\s+|$)/, '').strip
      end
    end
  end

  # 1. すべての Pod ターゲットの Deployment Target を 15.0 に揃える
  installer.pods_project.targets.each do |target|
    if target.respond_to?(:build_configurations)
      target.build_configurations.each do |config|
        config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.0'
      end
    end

    # Flutter公式の設定適用
    flutter_additional_ios_build_settings(target)

    # non-modular header と -G フラグの除去
    if target.respond_to?(:build_configurations)
      target.build_configurations.each do |config|
        config.build_settings['CLANG_ALLOW_NON_MODULAR_INCLUDES_IN_FRAMEWORK_MODULES'] = 'YES'
        remove_g_flag(config.build_settings)
      end
    end
  end

  # 2. アプリ本体（Runner）のターゲット設定からも -G フラグを除去
  runner_project_path = File.expand_path('../Runner.xcodeproj', __FILE__)
  if File.exist?(runner_project_path)
    runner_project = Xcodeproj::Project.open(runner_project_path)
    runner_project.targets.each do |target|
      target.build_configurations.each do |config|
        config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.0'
        remove_g_flag(config.build_settings)
      end
    end
    runner_project.save
  end

  # 3. 生成された全 .xcconfig / .pbxproj ファイル内の -G 文字列を直接削り取る
  ios_dir = File.expand_path('..', __FILE__)
  Dir.glob("#{ios_dir}/**/*.{xcconfig,pbxproj}").each do |file_path|
    next unless File.exist?(file_path)
    content = File.read(file_path)
    if content.include?('-G')
      new_content = content.gsub(/-G(\s+|$)/, '')
      File.write(file_path, new_content)
      puts "[Podfile] Cleared -G flag from #{file_path}"
    end
  end
end
