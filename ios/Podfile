$FirebaseSDKVersion = '10.24.0'
# Uncomment this line to define a global platform for your project
platform :ios, '15.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

# 古いXcodeでの互換性エラーを回避するためにSDWebImageのバージョンを固定します
pod 'SDWebImage', '~> 5.19.0'

target 'Runner' do
  use_frameworks!
  use_modular_headers!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))

  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  # Helper関数: CFlagsから -G を徹底的に消去する
  def sanitize_cflags(config)
    %w[OTHER_CFLAGS OTHER_CPLUSPLUSFLAGS GCC_PREPROCESSOR_DEFINITIONS CFLAGS CXXFLAGS].each do |flag_key|
      flags = config.build_settings[flag_key]
      next if flags.nil?

      if flags.is_a?(Array)
        flags.reject! { |flag| flag == '-G' || flag.to_s.include?('-G') }
      elsif flags.is_a?(String)
        config.build_settings[flag_key] = flags.gsub(/-G(\s+|$)/, '').strip
      end
    end
  end

  # 1. Pods プロジェクト内のすべてのターゲット（ライブラリ）の処理
  installer.pods_project.targets.each do |target|
    if target.respond_to?(:build_configurations)
      target.build_configurations.each do |config|
        config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.0'
      end
    end

    flutter_additional_ios_build_settings(target)

    if target.respond_to?(:build_configurations)
      target.build_configurations.each do |config|
        config.build_settings['CLANG_ALLOW_NON_MODULAR_INCLUDES_IN_FRAMEWORK_MODULES'] = 'YES'
        sanitize_cflags(config)
      end
    end
  end

  # 2. 【重要】Runner（アプリ本体）のプロジェクトファイルからも -G を削除する
  runner_project_path = File.expand_path('../Runner.xcodeproj', __FILE__)
  if File.exist?(runner_project_path)
    runner_project = Xcodeproj::Project.open(runner_project_path)
    runner_project.targets.each do |target|
      target.build_configurations.each do |config|
        config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.0'
        sanitize_cflags(config)
      end
    end
    runner_project.save
  end

  # 3. Flutter の全 .xcconfig ファイルから -G を直接削除する
  ios_dir = File.expand_path('..', __FILE__)
  Dir.glob("#{ios_dir}/**/*.xcconfig").each do |file_path|
    if File.exist?(file_path)
      content = File.read(file_path)
      if content.include?('-G')
        new_content = content.gsub(/-G(\s+|$)/, '')
        File.write(file_path, new_content)
      end
    end
  end
end
